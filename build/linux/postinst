#!/bin/bash

if type update-alternatives 2>/dev/null >&1; then
    # Remove previous link if it doesn't use update-alternatives
    if [ -L '/usr/bin/xuanlian-vpn' -a -e '/usr/bin/xuanlian-vpn' -a "`readlink '/usr/bin/xuanlian-vpn'`" != '/etc/alternatives/xuanlian-vpn' ]; then
        rm -f '/usr/bin/xuanlian-vpn'
    fi
    update-alternatives --install '/usr/bin/xuanlian-vpn' 'xuanlian-vpn' '/opt/xuanlian-vpn/xuanlian-vpn' 100 || ln -sf '/opt/xuanlian-vpn/xuanlian-vpn' '/usr/bin/xuanlian-vpn'
else
    ln -sf '/opt/xuanlian-vpn/xuanlian-vpn' '/usr/bin/xuanlian-vpn'
fi

sed -i 's/Name=xuanlian-vpn/Name=炫连VPN/' '/usr/share/applications/xuanlian-vpn.desktop'

chmod 4755 '/opt/xuanlian-vpn/chrome-sandbox' || true
chmod +sx /opt/xuanlian-vpn/resources/sidecar/mihomo
chmod +sx /opt/xuanlian-vpn/resources/sidecar/mihomo-alpha

if [ -d '/opt/xuanlian-vpn/resources/files/sub-store-frontend' ]; then
    chmod -R go-w '/opt/xuanlian-vpn/resources/files/sub-store-frontend' 2>/dev/null || true
fi

if hash update-mime-database 2>/dev/null; then
    update-mime-database /usr/share/mime || true
fi

if hash update-desktop-database 2>/dev/null; then
    update-desktop-database /usr/share/applications || true
fi
